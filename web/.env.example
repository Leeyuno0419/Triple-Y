# 복사해서 .env.local 로 사용 (.env.local 은 git 에 커밋하지 않는다)

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼(Web) 도메인에 http://localhost:5173 및 배포 도메인을 등록해야 지도가 뜬다.
VITE_KAKAO_JS_KEY=

# timeline.json 위치 (server/ 가 제공하는 URL 또는 정적 파일)
VITE_TIMELINE_URL=/timeline.json

# 실시간 WebSocket 주소 (비우면 실시간 연결 안 함). 개발용 mock 서버: npm run mock:ws → ws://localhost:8787
VITE_WS_URL=

# timeline 로드 실패 시 내장 mock 데이터로 대체할지 (개발용). 배포에서는 false 권장.
VITE_USE_MOCK=true
# 영상 폴더 URL. 영상은 `${VITE_VIDEO_BASE_URL}/${meta.video_id}.mp4` 로 찾는다 (예: E04_022 → /videos/E04_022.mp4).
# 영상 파일은 web/public/videos/ 에 두고 git 에 올리지 않는다 (원본 영상은 저장소 제외 규칙).
VITE_VIDEO_BASE_URL=/videos

# --- 로컬 테스트 (영상 + 가짜 timeline), .env.local 에만 쓴다 ---
# VITE_TIMELINE_URL=/data/fake_E04_022.pred.json   # web/public/data/ 에 두고 git 에 올리지 않는다
# VITE_USE_MOCK=false                                # 파일을 못 찾으면 mock 으로 숨기지 않고 오류를 보여 준다
