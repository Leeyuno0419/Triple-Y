# 비밀키
.env

# 데이터 (폴더 구조 유지용 .gitkeep만 추적)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 모델 가중치 (용량·라이선스 문제로 git 제외)
*.pth
*.pt
*.onnx
*.ckpt

# 서버 (Spring Boot)
server/build/
server/.gradle/
server/out/
server/logs/
*.class

# 화면 (React)
node_modules/
web/dist/
web/build/

# 로그·환경 파일 (.env.example만 추적)
*.log
.env.*
!.env.example

# 외부 코드 (P2PNet 공식 저장소, 학술 용도)
third_party/
